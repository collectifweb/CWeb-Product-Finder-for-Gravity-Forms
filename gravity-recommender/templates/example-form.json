{
  "0": {
    "title": "SaaS Plan Picker — Gravity Recommender Demo",
    "description": "Sample form shipped with Gravity Recommender. Answer 3 quick questions and we'll suggest the right plan.",
    "labelPlacement": "top_label",
    "descriptionPlacement": "below",
    "button": { "type": "text", "text": "Show my recommendation", "imageUrl": "" },
    "fields": [
      {
        "type": "radio",
        "id": 1,
        "label": "How big is your team?",
        "isRequired": true,
        "choices": [
          { "text": "Just me", "value": "solo", "isSelected": false },
          { "text": "2 to 10 people", "value": "small", "isSelected": false },
          { "text": "More than 10", "value": "large", "isSelected": false }
        ]
      },
      {
        "type": "checkbox",
        "id": 2,
        "label": "Which features matter most to you?",
        "description": "Pick everything that applies.",
        "isRequired": false,
        "choices": [
          { "text": "Integrations with other tools", "value": "integrations", "isSelected": false },
          { "text": "Advanced reporting & analytics", "value": "analytics", "isSelected": false },
          { "text": "Single sign-on (SSO)", "value": "sso", "isSelected": false },
          { "text": "Priority customer support", "value": "priority_support", "isSelected": false }
        ],
        "inputs": [
          { "id": "2.1", "label": "Integrations with other tools" },
          { "id": "2.2", "label": "Advanced reporting & analytics" },
          { "id": "2.3", "label": "Single sign-on (SSO)" },
          { "id": "2.4", "label": "Priority customer support" }
        ]
      },
      {
        "type": "radio",
        "id": 3,
        "label": "What's your monthly budget?",
        "isRequired": true,
        "choices": [
          { "text": "Under $20", "value": "low", "isSelected": false },
          { "text": "$20 – $50", "value": "medium", "isSelected": false },
          { "text": "$50 and up", "value": "high", "isSelected": false }
        ]
      },
      {
        "type": "hidden",
        "id": 4,
        "label": "Recommendation result (JSON)",
        "adminLabel": "gr_recommendation",
        "isRequired": false,
        "defaultValue": ""
      }
    ],
    "confirmations": {
      "default": {
        "id": "default",
        "name": "Default Confirmation",
        "type": "message",
        "message": "<h2>Your recommendation</h2>[gravity_recommender field_id=\"4\"]",
        "isDefault": true,
        "disableAutoformat": false
      }
    }
  },
  "version": "2.9"
}
